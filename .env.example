# Copy this file to .env and fill in your own values. Never commit .env.

# Main engine (free at console.groq.com)
GROQ_API_KEY=

# Optional backup with the same model as Groq (free at openrouter.ai, about 50 requests/day).
OPENROUTER_API_KEY=

# Optional last backup engine (free at aistudio.google.com). Leave empty if unused.
GEMINI_API_KEY=

# Set to true to create a temporary public Gradio link for demos.
RISKDESK_SHARE=false
